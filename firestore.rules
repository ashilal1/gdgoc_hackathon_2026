rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // usersコレクションの中の各ドキュメント（ドキュメントID = ユーザーのUID）に対するルール
    match /users/{userId} {
      // 読み取り: 誰でもOKな場合（アプリの仕様によります仕様による。自分しか見れないなら if request.auth.uid == userId; にする）
      allow read: if request.auth != null;

      // 書き込み: ログインしている本人のデータ（userId）だけ書き込み・更新を許可
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // clothesコレクションのルール
    match /clothes/{document=**} {
      allow read: if true; // テストのため一旦誰でも（あるいは if request.auth != null;）
      allow write: if false;
    }

    // 今後他のコレクション（例: posts）を作る場合、それらにはアクセスさせない（デフォルト拒否）
  }
